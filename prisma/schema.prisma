// ═══════════════════════════ TENANCY / AUTH / RBAC ═══════════════════════════

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model User {
  id                 String     @id @default(cuid())
  workspaceId        String
  name               String
  email              String     @unique
  passwordHash       String?
  avatarUrl          String?
  phone              String?
  title              String?
  timezone           String?
  status             UserStatus @default(ACTIVE)
  isStaff            Boolean    @default(false)
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  recoveryCodes      String[]
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  /// internal cost per hour (minor units) — profitability only, never exposed to clients
  hourlyCost         Int?
  hourlyCostCurrency String?
  isDemo             Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roles         UserRole[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]
  memberships   OrganizationMember[]

  clientsAsUser      Client[]                 @relation("ClientUser")
  clientsAsManager   Client[]                 @relation("ClientManager")
  assignedTasks      Task[]                   @relation("TaskAssignee")
  createdTasks       Task[]                   @relation("TaskCreator")
  createdVersions    VideoVersion[]           @relation("VersionCreator")
  approvedVersions   VideoVersion[]           @relation("VersionApprover")
  assignedLeads      Lead[]                   @relation("LeadAssignee")
  leadActivities     LeadActivity[]           @relation("LeadActivityActor")
  internalNotes      InternalNote[]           @relation("NoteAuthor")
  managedProjects    Project[]                @relation("ProjectManager")
  projectMemberships ProjectMember[]          @relation("ProjectMemberUser")
  statusChanges      ProjectStatusChange[]    @relation("StatusChangeActor")
  changeRequests     ChangeRequest[]          @relation("ChangeRequestSubmitter")
  fileRequests       FileRequest[]            @relation("FileRequester")
  taskComments       TaskComment[]            @relation("TaskCommentAuthor")
  timeEntries        TimeEntry[]              @relation("TimeEntryUser")
  uploadedAssets     Asset[]                  @relation("AssetUploader")
  videoComments      VideoComment[]           @relation("CommentAuthor")
  revisionRequests   RevisionRequest[]        @relation("RevisionSubmitter")
  sentMessages       Message[]                @relation("MessageSender")
  messageReads       MessageRead[]            @relation("MessageReader")
  notifications      Notification[]           @relation("UserNotifications")
  notificationPrefs  NotificationPreference[] @relation("UserNotificationPrefs")
  createdQuotes      Quote[]                  @relation("QuoteCreator")
  hostedMeetings     Meeting[]                @relation("MeetingHost")
  activityEntries    ActivityLog[]            @relation("ActivityActor")

  @@index([workspaceId, isStaff])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isStaff     Boolean  @default(true)
  isSystem    Boolean  @default(true)
  rank        Int      @default(0)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?
  group       String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  twoFactorPending Boolean  @default(false)
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String?
  email     String
  type      TokenType
  tokenHash String    @unique
  meta      Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, type])
  @@map("auth_tokens")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Organization {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  slug            String
  website         String?
  logoUrl         String?
  billingEmail    String?
  billingAddress  String?
  taxId           String?
  defaultCurrency String   @default("USD")
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members  OrganizationMember[]
  clients  Client[]
  projects Project[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  role           OrgMemberRole @default(MEMBER)
  title          String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ═══════════════════════════ CRM ═══════════════════════════

model LeadSource {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  isSystem Boolean @default(true)

  leads Lead[]

  @@map("lead_sources")
}

model Lead {
  id                  String           @id @default(cuid())
  workspaceId         String
  /// public-facing request ID shown on the confirmation page, e.g. REQ-2026-0007
  requestCode         String           @unique
  name                String
  email               String
  phone               String?
  company             String?
  website             String?
  instagram           String?
  youtube             String?
  linkedin            String?
  industry            String?
  clientType          String?
  lookingFor          String?
  serviceSlug         String?
  projectType         String?
  budgetRange         String?
  /// upper bound estimate in USD minor units used for scoring only
  budgetMax           Int?
  stylePrefs          String[]
  description         String?
  answers             Json?
  sourceId            String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmTerm             String?
  utmContent          String?
  referrer            String?
  referralCode        String?
  status              LeadStatus       @default(NEW)
  /// internal score 0-100 — NEVER exposed to clients
  score               Int              @default(0)
  scoreBreakdown      Json?
  temperature         LeadTemperature  @default(NEEDS_REVIEW)
  temperatureOverride LeadTemperature?
  assignedToId        String?
  lastContactAt       DateTime?
  nextFollowUpAt      DateTime?
  tags                String[]
  lostReason          String?
  convertedClientId   String?
  /// set when a signed-in returning client submits a new request from the portal
  existingClientId    String?
  isDemo              Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  source     LeadSource?    @relation(fields: [sourceId], references: [id])
  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  client     Client?        @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  quotes     Quote[]
  meetings   Meeting[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, temperature])
  @@index([email])
  @@index([assignedToId])
  @@index([existingClientId])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  title     String
  metadata  Json?
  actorId   String?
  createdAt DateTime @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model ContactSubmission {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  email       String
  phone       String?
  company     String?
  reason      ContactReason @default(GENERAL)
  message     String
  source      String?
  utm         Json?
  ip          String?
  handled     Boolean       @default(false)
  leadId      String?
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([workspaceId, createdAt])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, email])
  @@map("newsletter_subscribers")
}

model Client {
  id             String       @id @default(cuid())
  workspaceId    String
  organizationId String
  /// primary portal user
  userId         String?
  name           String
  email          String
  phone          String?
  companyName    String
  industry       String?
  website        String?
  socialLinks    Json?
  country        String?
  timezone       String?
  source         String?
  status         ClientStatus @default(PROSPECT)
  tags           String[]
  managerId      String?
  lastContactAt  DateTime?
  referralCode   String?      @unique
  /// first-time clients get extra guidance in onboarding
  firstTime      Boolean      @default(true)
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation("ClientUser", fields: [userId], references: [id], onDelete: SetNull)
  manager      User?           @relation("ClientManager", fields: [managerId], references: [id], onDelete: SetNull)
  profile      ClientProfile?
  brandKit     ClientBrandKit?
  leads        Lead[]          @relation("LeadConvertedClient")
  projects     Project[]
  quotes       Quote[]
  contracts    Contract[]
  invoices     Invoice[]
  payments     Payment[]
  retainers    Retainer[]
  messages     Message[]
  meetings     Meeting[]
  assets       Asset[]

  @@index([workspaceId, status])
  @@index([organizationId])
  @@index([email])
  @@map("clients")
}

model ClientProfile {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  brandSummary       String?
  editingPreferences String?
  preferredContact   String?
  communicationPrefs Json?
  /// manual checklist ticks, e.g. { "brand_assets": true }
  checklist          Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ClientBrandKit {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  logoAssetId        String?
  altLogoAssetIds    String[]
  colors             Json?
  fonts              Json?
  typographyRules    String?
  guidelinesAssetId  String?
  introAssetId       String?
  outroAssetId       String?
  watermarkAssetId   String?
  lowerThirdAssetIds String[]
  musicPreference    String?
  socialHandles      Json?
  websiteUrl         String?
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_brand_kits")
}

model InternalNote {
  id             String     @id @default(cuid())
  workspaceId    String
  entityType     NoteEntity
  entityId       String
  authorId       String
  body           String
  mentionUserIds String[]
  pinned         Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  author User @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("internal_notes")
}

model Referral {
  id               String         @id @default(cuid())
  workspaceId      String
  code             String
  referrerClientId String
  referredClientId String?
  referredLeadId   String?
  status           ReferralStatus @default(PENDING)
  reward           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([referrerClientId])
  @@index([code])
  @@map("referrals")
}

// ═══════════════════════════ CATALOG / CMS ═══════════════════════════

model ServiceCategory {
  id          String @id @default(cuid())
  workspaceId String
  key         String
  name        String
  sortOrder   Int    @default(0)

  services Service[]

  @@unique([workspaceId, key])
  @@map("service_categories")
}

model Service {
  id                   String   @id @default(cuid())
  workspaceId          String
  slug                 String
  title                String
  shortDescription     String
  description          String?
  categoryId           String?
  icon                 String   @default("clapperboard")
  useCase              String?
  deliverables         String[]
  included             String[]
  whoFor               String[]
  exampleDeliverables  String[]
  platforms            String[]
  editingStyle         String?
  addOns               Json?
  workflow             Json?
  revisionPolicy       String?
  turnaround           String?
  startingPrice        Int?
  currency             String   @default("USD")
  /// e.g. "Custom quote" — shown instead of a price when set
  priceLabel           String?
  faqCategory          String?
  onboardingCategories String[]
  seoTitle             String?
  seoDescription       String?
  heroImage            String?
  published            Boolean  @default(true)
  featured             Boolean  @default(false)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category  ServiceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projects  Project[]
  templates ProjectTemplate[]

  @@unique([workspaceId, slug])
  @@map("services")
}

model PricingPlan {
  id                String      @id @default(cuid())
  workspaceId       String
  /// admin-renameable tier label: Starter / Growth / Premium / Enterprise
  name              String
  tier              String?
  description       String?
  price             Int?
  currency          String      @default("USD")
  billingType       BillingType @default(ONE_TIME)
  priceNote         String?
  includedVideos    Int?
  includedShorts    Int?
  includedRevisions Int?
  hoursIncluded     Int?
  turnaround        String?
  resolution        String?
  motionGraphics    Boolean     @default(false)
  captions          Boolean     @default(false)
  soundDesign       Boolean     @default(false)
  prioritySupport   Boolean     @default(false)
  dedicatedEditor   Boolean     @default(false)
  storageGb         Int?
  features          String[]
  highlighted       Boolean     @default(false)
  ctaLabel          String?
  enabled           Boolean     @default(true)
  isDemo            Boolean     @default(false)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  retainers Retainer[]

  @@index([workspaceId, enabled])
  @@map("pricing_plans")
}

model ProjectType {
  id                    String   @id @default(cuid())
  workspaceId           String
  key                   String
  name                  String
  defaultTurnaroundDays Int      @default(5)
  defaultRevisionLimit  Int      @default(2)
  onboardingCategories  String[]
  sortOrder             Int      @default(0)

  projects Project[]

  @@unique([workspaceId, key])
  @@map("project_types")
}

model PortfolioProject {
  id             String        @id @default(cuid())
  workspaceId    String
  slug           String
  title          String
  description    String?
  clientName     String?
  industry       String?
  category       String
  projectType    String?
  platforms      String[]
  videoUrl       String?
  thumbnailUrl   String?
  beforeVideoUrl String?
  afterVideoUrl  String?
  /// optional real metrics — admin entered only, never fabricated
  results        Json?
  testimonial    String?
  tags           String[]
  featured       Boolean       @default(false)
  status         PublishStatus @default(PUBLISHED)
  sortOrder      Int           @default(0)
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  caseStudy CaseStudy?

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, featured])
  @@map("portfolio_projects")
}

model CaseStudy {
  id                 String        @id @default(cuid())
  workspaceId        String
  portfolioProjectId String?       @unique
  slug               String
  title              String
  clientName         String
  industry           String?
  summary            String?
  problem            String?
  objective          String?
  strategy           String?
  creativeDirection  String?
  beforeVideoUrl     String?
  afterVideoUrl      String?
  heroImage          String?
  /// { views?, watchTime?, engagement?, ctr?, leads?, conversions?, custom?: [{label,value}] } — all optional
  results            Json?
  clientFeedback     String?
  feedbackAuthor     String?
  deliverables       String[]
  timeline           String?
  seoTitle           String?
  seoDescription     String?
  status             PublishStatus @default(PUBLISHED)
  isDemo             Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  portfolioProject PortfolioProject? @relation(fields: [portfolioProjectId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, slug])
  @@map("case_studies")
}

model Testimonial {
  id                  String            @id @default(cuid())
  workspaceId         String
  projectId           String?
  clientId            String?
  rating              Int
  quote               String
  permissionToPublish Boolean           @default(false)
  name                String
  role                String?
  company             String?
  imageUrl            String?
  status              TestimonialStatus @default(PENDING)
  featured            Boolean           @default(false)
  isDemo              Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([workspaceId, status])
  @@map("testimonials")
}

model TestimonialRequest {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String    @unique
  clientId    String
  token       String    @unique
  sentAt      DateTime  @default(now())
  completedAt DateTime?

  @@map("testimonial_requests")
}

model Faq {
  id           String   @id @default(cuid())
  workspaceId  String
  category     String
  question     String
  answer       String
  /// show on these service pages (slugs). empty = only on /faq
  serviceSlugs String[]
  sortOrder    Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, category])
  @@map("faqs")
}

model KbArticle {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String
  title       String
  content     String
  category    String   @default("General")
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@map("kb_articles")
}

model BlogCategory {
  id          String @id @default(cuid())
  workspaceId String
  slug        String
  name        String

  posts BlogPost[]

  @@unique([workspaceId, slug])
  @@map("blog_categories")
}

model BlogPost {
  id              String        @id @default(cuid())
  workspaceId     String
  slug            String
  title           String
  excerpt         String?
  content         String
  featuredImage   String?
  categoryId      String?
  authorId        String?
  authorName      String?
  seoTitle        String?
  metaDescription String?
  tags            String[]
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, publishedAt])
  @@map("blog_posts")
}

model Setting {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, key])
  @@map("settings")
}

model Counter {
  workspaceId String
  key         String
  value       Int    @default(0)

  @@id([workspaceId, key])
  @@map("counters")
}

// ═══════════════════════════ ONBOARDING ENGINE ═══════════════════════════

model OnboardingForm {
  id          String  @id @default(cuid())
  workspaceId String
  key         String
  name        String
  description String?

  sections  OnboardingSection[]
  questions OnboardingQuestion[]

  @@unique([workspaceId, key])
  @@map("onboarding_forms")
}

model OnboardingSection {
  id          String  @id @default(cuid())
  formId      String
  key         String
  title       String
  description String?
  sortOrder   Int     @default(0)

  form      OnboardingForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  questions OnboardingQuestion[]

  @@unique([formId, key])
  @@map("onboarding_sections")
}

/// A reusable question group, e.g. COMMON, REAL_ESTATE, PODCAST, GAMING…
model OnboardingCategory {
  id          String @id @default(cuid())
  workspaceId String
  key         String
  name        String
  sortOrder   Int    @default(0)

  questions OnboardingQuestion[]

  @@unique([workspaceId, key])
  @@map("onboarding_categories")
}

model OnboardingQuestion {
  id               String       @id @default(cuid())
  formId           String
  sectionId        String
  /// stable machine key used by conditional logic and stored answers
  key              String
  text             String
  helpText         String?
  placeholder      String?
  type             QuestionType @default(TEXT)
  required         Boolean      @default(false)
  /// { all?: Cond[], any?: Cond[] } where Cond = { field, op, value }
  conditionalLogic Json?
  /// { min,max,accept,maxSizeMb,display:'cards'|'chips', leadField:'budgetRange' … }
  meta             Json?
  sortOrder        Int          @default(0)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  form       OnboardingForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  section    OnboardingSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  categories OnboardingCategory[]
  options    OnboardingOption[]

  @@unique([formId, key])
  @@index([formId, sectionId, sortOrder])
  @@map("onboarding_questions")
}

model OnboardingOption {
  id           String   @id @default(cuid())
  questionId   String
  label        String
  value        String
  sortOrder    Int      @default(0)
  /// selecting this option pulls these question categories into the flow
  categoryKeys String[]
  icon         String?
  description  String?

  question OnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
  @@map("onboarding_options")
}

model OnboardingResponse {
  id           String   @id @default(cuid())
  workspaceId  String
  formKey      String
  /// LEAD | PROJECT
  subjectType  String
  subjectId    String
  questionKey  String
  questionText String
  value        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subjectType, subjectId, questionKey])
  @@index([subjectType, subjectId])
  @@map("onboarding_responses")
}

/// Autosaved, resumable form state. Anonymous visitors resume via an unguessable token.
model OnboardingDraft {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  userId      String?
  formKey     String
  subjectType String?
  subjectId   String?
  data        Json
  step        Int       @default(0)
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([userId, formKey])
  @@index([subjectType, subjectId])
  @@map("onboarding_drafts")
}

// ═══════════════════════════ PROJECTS ═══════════════════════════

model Project {
  id              String        @id @default(cuid())
  workspaceId     String
  organizationId  String
  clientId        String
  /// human friendly ID, e.g. P-1042
  code            String
  serviceId       String?
  projectTypeId   String?
  templateId      String?
  sourceProjectId String?
  /// set when the work is billed against a monthly retainer allowance
  retainerId      String?
  /// the inquiry this project originated from
  leadId          String?
  name            String
  description     String?
  status          ProjectStatus @default(INQUIRY)
  priority        Priority      @default(NORMAL)
  deadline        DateTime?
  startDate       DateTime?
  completionDate  DateTime?
  deliveredAt     DateTime?
  managerId       String?
  /// clients only see projects once the studio has released them (quote sent / activated)
  clientVisible   Boolean       @default(false)
  /// agreed scope: { deliverables:[{label,quantity}], revisionRounds, turnaroundBusinessDays, notes }
  scope           Json?
  revisionLimit   Int           @default(2)
  revisionsUsed   Int           @default(0)
  rushFee         Int?
  currency        String        @default("USD")
  /// internal-only financials for profitability
  internalCost    Int?
  /// admin override of payment gating (audit-logged)
  gateOverride    Boolean       @default(false)
  brandOverrides  Json?
  tags            String[]
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service        Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  projectType    ProjectType?          @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  template       ProjectTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  manager        User?                 @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  brief          ProjectBrief?
  statusChanges  ProjectStatusChange[]
  folders        AssetFolder[]
  assets         Asset[]
  versions       VideoVersion[]
  revisions      RevisionRequest[]
  comments       VideoComment[]
  tasks          Task[]
  quotes         Quote[]
  contracts      Contract[]
  invoices       Invoice[]
  messages       Message[]
  changeRequests ChangeRequest[]
  fileRequests   FileRequest[]
  timeEntries    TimeEntry[]
  activity       ActivityLog[]
  retainerUsage  RetainerUsage[]

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
  @@index([organizationId])
  @@index([clientId])
  @@index([deadline])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(EDITOR)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, role])
  @@index([userId])
  @@map("project_members")
}

model ProjectStatusChange {
  id         String         @id @default(cuid())
  projectId  String
  fromStatus ProjectStatus?
  toStatus   ProjectStatus
  actorId    String?
  comment    String?
  /// true when an admin bypassed gating rules
  override   Boolean        @default(false)
  createdAt  DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("StatusChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_status_changes")
}

model ProjectBrief {
  id          String    @id @default(cuid())
  projectId   String    @unique
  version     Int       @default(1)
  /// { sections: [{ key, title, items: [{ label, value }] }] }
  content     Json
  /// DRAFT (client can edit) → LOCKED (production started, changes need a ChangeRequest)
  status      String    @default("DRAFT")
  confirmedAt DateTime?
  lockedAt    DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_briefs")
}

model ChangeRequest {
  id                     String               @id @default(cuid())
  workspaceId            String
  projectId              String
  submittedById          String
  whatChanged            String
  why                    String?
  additionalRequirements String?
  referenceAssetIds      String[]
  classification         ChangeClassification @default(PENDING)
  staffNote              String?
  quoteId                String?
  resolvedById           String?
  resolvedAt             DateTime?
  createdAt              DateTime             @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User    @relation("ChangeRequestSubmitter", fields: [submittedById], references: [id])

  @@index([projectId])
  @@map("change_requests")
}

model FileRequest {
  id               String            @id @default(cuid())
  workspaceId      String
  projectId        String
  requestedById    String
  title            String
  description      String?
  acceptedTypes    String[]
  status           FileRequestStatus @default(OPEN)
  fulfilledAssetId String?
  fulfilledAt      DateTime?
  createdAt        DateTime          @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("FileRequester", fields: [requestedById], references: [id])

  @@index([projectId, status])
  @@map("file_requests")
}

model ProjectTemplate {
  id                    String   @id @default(cuid())
  workspaceId           String
  name                  String
  description           String?
  serviceId             String?
  projectTypeKey        String?
  defaultTurnaroundDays Int      @default(5)
  defaultRevisionLimit  Int      @default(2)
  /// [{ title, role?, offsetDays?, subtasks?: string[] }]
  tasks                 Json?
  requiredAssets        String[]
  questionKeys          String[]
  /// [{ label, quantity }]
  deliverables          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  service   Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  projects  Project[]
  schedules RecurringSchedule[]

  @@map("project_templates")
}

model RecurringSchedule {
  id          String           @id @default(cuid())
  workspaceId String
  clientId    String
  templateId  String
  name        String
  cadence     RecurringCadence @default(WEEKLY)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())

  template ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt])
  @@map("recurring_schedules")
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  projectId   String?
  parentId    String?
  title       String
  description String?
  assigneeId  String?
  priority    Priority   @default(NORMAL)
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  sortOrder   Int        @default(0)
  createdById String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project     Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Task?         @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]        @relation("Subtasks")
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  timeEntries TimeEntry[]

  @@index([assigneeId, status])
  @@index([projectId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

model TimeEntry {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  userId      String
  taskId      String?
  startedAt   DateTime
  endedAt     DateTime?
  seconds     Int       @default(0)
  note        String?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("TimeEntryUser", fields: [userId], references: [id])
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId, startedAt])
  @@map("time_entries")
}

// ═══════════════════════════ FILES / VIDEO REVIEW ═══════════════════════════

model AssetFolder {
  id        String @id @default(cuid())
  projectId String
  key       String
  name      String
  sortOrder Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  Asset[]

  @@unique([projectId, key])
  @@map("asset_folders")
}

model Asset {
  id               String      @id @default(cuid())
  workspaceId      String
  /// null for brand-kit / inquiry attachments
  projectId        String?
  clientId         String?
  leadId           String?
  /// anonymous inquiry upload session (before a Lead exists)
  draftToken       String?
  folderId         String?
  uploadedById     String?
  filename         String
  displayName      String
  storageKey       String      @unique
  mimeType         String
  sizeBytes        BigInt      @default(0)
  version          Int         @default(1)
  /// normalised base name, so Interview_Final.mp4 / _V2 / _V3 group together
  versionGroup     String?
  status           AssetStatus @default(UPLOADING)
  scanStatus       String      @default("pending")
  thumbnailKey     String?
  durationMs       Int?
  checksum         String?
  /// only meaningful for final deliverables
  isDeliverable    Boolean     @default(false)
  deliverableLabel String?
  visibleToClient  Boolean     @default(true)
  sharedToken      String?     @unique
  isDemo           Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  project            Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  folder             AssetFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy         User?               @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  videoVersions      VideoVersion[]
  messageAttachments MessageAttachment[]

  @@index([projectId, folderId, status])
  @@index([clientId])
  @@index([leadId])
  @@index([draftToken])
  @@index([projectId, versionGroup])
  @@map("assets")
}

model VideoVersion {
  id            String              @id @default(cuid())
  workspaceId   String
  projectId     String
  versionNumber Int
  /// "V1", "V2", "Final"
  label         String
  assetId       String?
  /// external URL alternative (e.g. Vimeo/Frame link)
  videoUrl      String?
  thumbnailKey  String?
  durationMs    Int?
  notes         String?
  changeSummary String?
  createdById   String?
  reviewStatus  VersionReviewStatus @default(PENDING_CLIENT)
  isFinal       Boolean             @default(false)
  /// null until the version has been released to the client (internal drafts stay invisible to them)
  releasedAt    DateTime?
  approvedById  String?
  approvedAt    DateTime?
  approvalNotes String?
  isDemo        Boolean             @default(false)
  createdAt     DateTime            @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset      Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy  User?             @relation("VersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?             @relation("VersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  comments   VideoComment[]
  revisions  RevisionRequest[]

  @@unique([projectId, versionNumber])
  @@index([projectId, createdAt])
  @@map("video_versions")
}

model VideoComment {
  id           String         @id @default(cuid())
  workspaceId  String
  projectId    String
  versionId    String
  userId       String
  parentId     String?
  /// milliseconds from start
  timecodeMs   Int
  comment      String
  status       RevisionStatus @default(OPEN)
  isStaff      Boolean        @default(false)
  revisionId   String?
  isDemo       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version  VideoVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user     User             @relation("CommentAuthor", fields: [userId], references: [id])
  parent   VideoComment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  VideoComment[]   @relation("CommentReplies")
  revision RevisionRequest? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([versionId, timecodeMs])
  @@index([projectId, status])
  @@map("video_comments")
}

model RevisionRequest {
  id                  String         @id @default(cuid())
  workspaceId         String
  projectId           String
  versionId           String
  submittedById       String
  description         String
  status              RevisionStatus @default(OPEN)
  priority            Priority       @default(NORMAL)
  roundNumber         Int            @default(1)
  resolvedInVersionId String?
  isDemo              Boolean        @default(false)
  createdAt           DateTime       @default(now())
  resolvedAt          DateTime?

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     VideoVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  submittedBy User           @relation("RevisionSubmitter", fields: [submittedById], references: [id])
  comments    VideoComment[]

  @@index([projectId, status])
  @@map("revision_requests")
}

// ═══════════════════════════ COMMUNICATION ═══════════════════════════

model Message {
  id             String       @id @default(cuid())
  workspaceId    String
  organizationId String
  clientId       String
  projectId      String?
  senderId       String
  /// which group the client addressed (or CLIENT when staff reply)
  recipientGroup MessageGroup @default(PROJECT_MANAGER)
  body           String
  mentionUserIds String[]
  links          String[]
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender      User                @relation("MessageSender", fields: [senderId], references: [id])
  attachments MessageAttachment[]
  reads       MessageRead[]

  @@index([projectId, createdAt])
  @@index([clientId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  assetId   String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([messageId, assetId])
  @@map("message_attachments")
}

model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReader", fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reads")
}

model Notification {
  id          String               @id @default(cuid())
  workspaceId String
  userId      String
  category    NotificationCategory @default(SYSTEM)
  type        String
  title       String
  message     String?
  link        String?
  readAt      DateTime?
  isDemo      Boolean              @default(false)
  createdAt   DateTime             @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String               @id @default(cuid())
  userId   String
  category NotificationCategory
  inApp    Boolean              @default(true)
  email    Boolean              @default(true)

  user User @relation("UserNotificationPrefs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model EmailTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  name        String
  subject     String
  body        String
  variables   String[]
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, key])
  @@map("email_templates")
}

model EmailLog {
  id                String      @id @default(cuid())
  workspaceId       String
  toEmail           String
  toUserId          String?
  subject           String
  body              String
  templateKey       String?
  status            EmailStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  metadata          Json?
  createdAt         DateTime    @default(now())
  sentAt            DateTime?

  @@index([workspaceId, createdAt])
  @@index([toEmail])
  @@map("email_logs")
}

// ═══════════════════════════ BILLING ═══════════════════════════

model Quote {
  id              String      @id @default(cuid())
  workspaceId     String
  organizationId  String
  clientId        String
  projectId       String?
  leadId          String?
  /// set for change-order quotes
  changeRequestId String?
  number          String
  title           String?
  currency        String      @default("USD")
  subtotal        Int         @default(0)
  discount        Int         @default(0)
  /// tax rate in basis points (1000 = 10.00%)
  taxRateBps      Int         @default(0)
  tax             Int         @default(0)
  total           Int         @default(0)
  depositPercent  Int         @default(100)
  deposit         Int         @default(0)
  balance         Int         @default(0)
  status          QuoteStatus @default(DRAFT)
  validUntil      DateTime?
  notes           String?
  terms           String?
  sentAt          DateTime?
  viewedAt        DateTime?
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedIp      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdById     String?
  isDemo          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lead      Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     QuoteItem[]
  contracts Contract[]
  invoices  Invoice[]

  @@unique([workspaceId, number])
  @@index([organizationId, status])
  @@index([projectId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  serviceId   String?
  description String
  quantity    Float   @default(1)
  unitPrice   Int
  amount      Int
  sortOrder   Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model Contract {
  id             String         @id @default(cuid())
  workspaceId    String
  organizationId String
  clientId       String
  projectId      String
  quoteId        String?
  number         String
  title          String
  status         ContractStatus @default(DRAFT)
  currentVersion Int            @default(1)
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  signedById     String?
  declinedAt     DateTime?
  createdById    String?
  isDemo         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote    Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  versions ContractVersion[]

  @@unique([workspaceId, number])
  @@index([organizationId, status])
  @@index([projectId])
  @@map("contracts")
}

model ContractVersion {
  id          String   @id @default(cuid())
  contractId  String
  version     Int
  /// [{ key, title, body }] — rendered as escaped text, never raw HTML
  sections    Json
  variables   Json?
  contentHash String
  createdById String?
  createdAt   DateTime @default(now())

  contract   Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signatures ContractSignature[]

  @@unique([contractId, version])
  @@map("contract_versions")
}

model ContractSignature {
  id                String   @id @default(cuid())
  contractVersionId String
  signerUserId      String
  signerName        String
  signerEmail       String
  /// typed name or drawn PNG data-URL (size limited)
  signatureData     String
  signatureKind     String   @default("typed")
  acceptedTerms     Boolean  @default(true)
  ip                String?
  userAgent         String?
  contentHash       String
  signedAt          DateTime @default(now())

  version ContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)

  @@index([contractVersionId])
  @@map("contract_signatures")
}

model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  organizationId String
  clientId       String
  projectId      String?
  quoteId        String?
  retainerId     String?
  number         String
  kind           InvoiceKind   @default(FULL)
  currency       String        @default("USD")
  subtotal       Int           @default(0)
  discount       Int           @default(0)
  tax            Int           @default(0)
  total          Int           @default(0)
  amountPaid     Int           @default(0)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  paidAt         DateTime?
  paymentMethod  String?
  notes          String?
  createdById    String?
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote    Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  retainer Retainer?     @relation(fields: [retainerId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([workspaceId, number])
  @@index([organizationId, status])
  @@index([projectId])
  @@index([dueDate, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Int
  amount      Int
  sortOrder   Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(cuid())
  workspaceId    String
  invoiceId      String
  clientId       String
  organizationId String
  amount         Int
  currency       String
  provider       String
  transactionId  String?
  method         String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  metadata       Json?
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([provider, transactionId])
  @@index([invoiceId])
  @@index([organizationId])
  @@map("payments")
}

model Retainer {
  id                String         @id @default(cuid())
  workspaceId       String
  organizationId    String
  clientId          String
  planId            String?
  name              String
  monthlyPrice      Int
  currency          String         @default("USD")
  videosIncluded    Int            @default(0)
  shortsIncluded    Int            @default(0)
  hoursIncluded     Int            @default(0)
  turnaroundDays    Int            @default(5)
  revisionsIncluded Int            @default(2)
  startDate         DateTime
  renewalDate       DateTime
  status            RetainerStatus @default(ACTIVE)
  notes             String?
  isDemo            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan     PricingPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  usage    RetainerUsage[]
  invoices Invoice[]

  @@index([organizationId, status])
  @@index([renewalDate])
  @@map("retainers")
}

model RetainerUsage {
  id          String   @id @default(cuid())
  retainerId  String
  projectId   String?
  periodStart DateTime
  /// VIDEO | SHORT | HOURS
  kind        String
  quantity    Float    @default(1)
  note        String?
  createdAt   DateTime @default(now())

  retainer Retainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([retainerId, periodStart])
  @@map("retainer_usage")
}

// ═══════════════════════════ SCHEDULING ═══════════════════════════

model Meeting {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String?
  leadId      String?
  projectId   String?
  hostId      String?
  type        MeetingType   @default(DISCOVERY_CALL)
  title       String
  name        String?
  email       String?
  startsAt    DateTime
  endsAt      DateTime
  timezone    String?
  meetingUrl  String?
  notes       String?
  status      MeetingStatus @default(SCHEDULED)
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  host   User?   @relation("MeetingHost", fields: [hostId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startsAt])
  @@map("meetings")
}

model CalendarEvent {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  kind        String    @default("custom")
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean   @default(false)
  projectId   String?
  clientId    String?
  createdById String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, startsAt])
  @@map("calendar_events")
}

// ═══════════════════════════ AUTOMATION / JOBS / LOGS ═══════════════════════════

model Automation {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  event       String
  /// optional filter, same shape as onboarding conditional logic against the event payload
  conditions  Json?
  enabled     Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions AutomationAction[]
  runs    AutomationRun[]

  @@index([workspaceId, event, enabled])
  @@map("automations")
}

model AutomationAction {
  id           String               @id @default(cuid())
  automationId String
  type         AutomationActionType
  /// { recipient:'client'|'assignee'|'manager'|'admins'|'editors', templateKey?, title?, message?, link?, toStatus?, taskTitle?, … }
  config       Json
  delayMinutes Int                  @default(0)
  sortOrder    Int                  @default(0)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, sortOrder])
  @@map("automation_actions")
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  event        String
  entityId     String?
  status       String
  error        String?
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@map("automation_runs")
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, runAt])
  @@map("jobs")
}

/// Client- or team-facing timeline (project/client/lead history).
model ActivityLog {
  id          String             @id @default(cuid())
  workspaceId String
  actorId     String?
  type        String
  message     String
  entityType  String?
  entityId    String?
  projectId   String?
  clientId    String?
  leadId      String?
  visibility  ActivityVisibility @default(INTERNAL)
  metadata    Json?
  isDemo      Boolean            @default(false)
  createdAt   DateTime           @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
  @@map("activity_logs")
}

/// Immutable security/business audit trail.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  actorLabel  String?
  action      String
  entityType  String
  entityId    String?
  message     String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
