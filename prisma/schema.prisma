// FaizanEdits Pro — video editing studio platform
//
// Conventions
//  • Money is stored as INTEGER MINOR UNITS (cents/paisa) next to an explicit `currency` code. Never assume USD.
//  • Large media is NEVER stored here. `Asset.storageKey` is a reference into object storage (S3/R2/local-signed).
//  • `workspaceId` is a plain indexed column on every tenant-owned table (multi-tenant ready without FK bloat).
//  • `isDemo` marks seeded fictional rows so `npm run db:clear-demo` can remove them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════ ENUMS ═══════════════════════════

