# ─── Core ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://faizan:faizan_dev@127.0.0.1:5432/faizaneditspro"
# 32+ random chars. Signs sessions' CSRF tokens, storage URLs, encrypts 2FA secrets.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
APP_URL="http://localhost:3000"
# true = demo accounts + demo data banners + provider fallbacks (console email, demo checkout, local storage)
DEMO_MODE="true"
CRON_SECRET="change-me-cron-secret"

# ─── Storage (media never lives in Postgres) ────────────────────────────
# local | s3   (s3 works with AWS S3, Cloudflare R2, Supabase Storage S3 endpoint, GCS interop)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".storage"
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_MAX_UPLOAD_GB="20"

# ─── Payments ───────────────────────────────────────────────────────────
# demo | stripe
PAYMENT_PROVIDER="demo"
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ─── Email ──────────────────────────────────────────────────────────────
# console | resend | postmark | sendgrid
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="Studio <hello@example.com>"

# ─── Auth providers (optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Anti-spam (optional Cloudflare Turnstile) ──────────────────────────
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── Malware scanning (optional) ────────────────────────────────────────
# none | clamav-http  (POST file to CLAMAV_URL, expects JSON {infected:boolean})
SCAN_PROVIDER="none"
CLAMAV_URL=""

# ─── Background jobs ────────────────────────────────────────────────────
# true runs the job loop inside the web process (fine for single-node); set false and run `npm run worker` elsewhere for scale
JOBS_INLINE="true"

# ─── Calendar / meeting links (abstraction; internal by default) ────────
CALENDAR_PROVIDER="internal"
MEETING_URL_TEMPLATE="https://meet.example.com/{{code}}"
