    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
