{
  "name": "faizaneditspro",
  "version": "1.0.0",
  "private": true,
  "description": "Video editing studio website + client management platform (CRM, portal, review, billing, automation).",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:clear-demo": "tsx scripts/clear-demo.ts",
    "db:reset": "prisma migrate reset --force",
    "worker": "tsx scripts/worker.ts",
    "test:e2e": "tsx scripts/e2e-workflow.ts",
    "test:ui": "node scripts/ui-flows.mjs",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
