# FaizanEdits Pro — Apache / LiteSpeed rules (works on standard cPanel hosting)
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Private files and folders are never served to the web.
    RewriteRule ^(app|storage|tests|migration-tools|vendor)(/|$) - [F,L]
    RewriteRule ^(config\.php|database\.sql|database-demo\.sql|README\.md|MIGRATION_MAP\.md)$ - [F,L,NC]
    RewriteRule \.(sql|log|key|ini|bak|md)$ - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]

    # Real files (CSS, JS, images, fonts) are served directly.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else goes to the application.
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Security headers are also sent by PHP; these cover static files.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Long-lived caching for versioned static assets.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
