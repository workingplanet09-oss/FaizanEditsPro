# Nothing in here is ever served directly — files are handed out by the application to people allowed to see them.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
